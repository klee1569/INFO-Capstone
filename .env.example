OPENAI_API_KEY=example_api_key_here
# DO NOT ACTUALLY PUT YOUR API KEY HERE. This is just an example file. 
# You should create a .env.local file and put your API key there. .env, .env.local, are already in the .gitignore file, so they won't be committed to version control. This is important for security reasons, as you don't want to accidentally expose your API key in a public repository.
